{
  "manifest_version": 3,
  "name": "Camden Product Exporter",
  "version": "1.0.0",
  "description": "Extract Camden quotation products and displayed prices into clipboard JSON.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Export Camden products",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
